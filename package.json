{
  "name": "decoroom",
  "version": "0.1.0",
  "private": true,
  "description": "Sketch a room's layout and share it as a link",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-cli.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "cli": "node dist/decoroom.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "preact": "^11.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/node": "^26.6.7",
    "@types/three": "^0.187.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
